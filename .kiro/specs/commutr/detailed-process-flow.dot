digraph DetailedProcessFlow {
    rankdir=LR;
    node [fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=10];
    
    graph [bgcolor=white, pad=0.5, nodesep=0.5, ranksep=0.8];
    
    // Start
    Start [shape=ellipse, style=filled, fillcolor="#4CAF50", fontcolor=white, label="START", width=1.2, height=0.8];
    
    // Step 1: User opens app
    Step1 [shape=box, style="rounded,filled", fillcolor="#2196F3", fontcolor=white, label="User Opens\nWeb App", width=1.5, height=0.8];
    
    // Step 2: User enters locations
    Step2 [shape=box, style="rounded,filled", fillcolor="#2196F3", fontcolor=white, label="User Enters\nSource &\nDestination", width=1.5, height=0.8];
    
    // Step 3: User selects preferences
    Step3 [shape=box, style="rounded,filled", fillcolor="#2196F3", fontcolor=white, label="User Selects\nPreferences:\n• Cheapest route\n• Accessibility\n• Walking limit", width=1.8, height=1.0];
    
    // Step 4: System validates
    Step4 [shape=box, style="rounded,filled", fillcolor="#FF9800", fontcolor=white, label="System\nValidates\nInputs", width=1.5, height=0.8];
    
    // Step 5: System fetches routes
    Step5 [shape=box, style="rounded,filled", fillcolor="#FF9800", fontcolor=white, label="System Fetches\nAvailable Public\nTransport Routes", width=1.8, height=0.8];
    
    // Step 6: System calculates fare
    Step6 [shape=box, style="rounded,filled", fillcolor="#FF9800", fontcolor=white, label="System\nCalculates\nEstimated Fare\nfor Each Route", width=1.8, height=1.0];
    
    // Step 7: System checks accessibility
    Step7 [shape=box, style="rounded,filled", fillcolor="#FF9800", fontcolor=white, label="System Checks\nAccessibility:\n• Stairs\n• Walking distance\n• Transfers", width=1.8, height=1.0];
    
    // Decision point
    Decision [shape=diamond, style=filled, fillcolor="#FFC107", fontcolor=black, label="Accessible\nRoutes\nAvailable?", width=1.8, height=1.2];
    
    // Alternative path
    Alternative [shape=box, style="rounded,filled", fillcolor="#FF5722", fontcolor=white, label="Show Closest\nPossible\nAlternative", width=1.5, height=0.8];
    
    // Step 9: System ranks routes
    Step9 [shape=box, style="rounded,filled", fillcolor="#FF9800", fontcolor=white, label="System Ranks\nRoutes by:\n• Lowest cost\n• Accessibility\n  score", width=1.8, height=1.0];
    
    // Step 10: Generate instructions
    Step10 [shape=box, style="rounded,filled", fillcolor="#FF9800", fontcolor=white, label="System\nGenerates\nStep-by-Step\nInstructions", width=1.8, height=1.0];
    
    // Step 11: User receives results
    Step11 [shape=box, style="rounded,filled", fillcolor="#2196F3", fontcolor=white, label="User Receives:\n• Final route\n• Cost breakdown\n• Accessibility info", width=1.8, height=1.0];
    
    // End
    End [shape=ellipse, style=filled, fillcolor="#4CAF50", fontcolor=white, label="END", width=1.2, height=0.8];
    
    // Flow connections
    Start -> Step1;
    Step1 -> Step2;
    Step2 -> Step3;
    Step3 -> Step4;
    Step4 -> Step5;
    Step5 -> Step6;
    Step6 -> Step7;
    Step7 -> Decision;
    
    // Decision branches
    Decision -> Step9 [label="Yes", fontcolor="#4CAF50", color="#4CAF50", penwidth=2];
    Decision -> Alternative [label="No", fontcolor="#F44336", color="#F44336", penwidth=2];
    Alternative -> Step9 [style=dashed];
    
    Step9 -> Step10;
    Step10 -> Step11;
    Step11 -> End;
    
    // Legend
    {
        rank=same;
        Legend [shape=box, style="rounded,filled", fillcolor="#EEEEEE", fontcolor=black, 
                label="LEGEND:\n━━━━━━━━━━━━━━\nBlue = User Action\nOrange = System Process\nYellow = Decision Point\nRed = Alternative Path", 
                width=2.2, height=1.2];
    }
}
